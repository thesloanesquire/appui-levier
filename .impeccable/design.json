      "css": ":root{--ink:#1F2A44;--ink-2:#4F5870;--ink-3:#5F6679;--accent:#B8613F;--accent-strong:#9C4D2E;--accent-ink:#8A4429;--accent-soft:#FBEEE7;--on-accent:#FFFFFF;--bg:#FAF9F7;--surface:#FFFFFF;--hover:#F5F3EF;--sunk:#F1EEE9;--line:#E9E5DE;--line-strong:#D9D3C9;--ok:#2C6E4C;--ok-soft:#E5F2EA;--warn:#8C5A0E;--warn-soft:#FBF0DA;--info-soft:#EBEEF6;--ease:cubic-bezier(.16,1,.3,1);--sh-1:0 1px 2px rgba(31,42,68,.05),0 0 0 1px rgba(31,42,68,.02)}.ds-field{font-family:'Hanken Grotesk',system-ui,-apple-system,'Segoe UI',sans-serif;display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:600;color:var(--ink)}.ds-input{font:400 14px 'Hanken Grotesk',system-ui,sans-serif;height:36px;padding:0 12px;border:1px solid var(--line-strong);border-radius:8px;background:var(--surface);color:var(--ink);transition:border-color .15s,box-shadow .15s}.ds-input:hover{border-color:var(--ink-3)}.ds-input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 18%,transparent)}.ds-input::placeholder{color:var(--ink-3)}"
